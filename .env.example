# Copie este arquivo para .env.local e preencha com os dados do seu projeto Neon.

# Console do Neon → seu projeto → Auth → "Auth URL"
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.REGIAO.aws.neon.tech/neondb/auth

# Console do Neon → seu projeto → Data API → "API URL"
VITE_NEON_DATA_API_URL=https://ep-xxxx.apirest.REGIAO.aws.neon.tech/neondb/rest/v1

# Upload de imagens no painel: no site publicado usa /api/images (Vercel Blob).
# No `yarn dev` fica desligado e o painel aceita imagens por link.


# Só para `yarn db:migrate` (não vai para o navegador, não tem o prefixo VITE_).
# Console do Neon → Connect → connection string da branch que você usa localmente.
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require

# Endereço público do site (para a imagem de compartilhamento). Padrão: https://bizzgu.vercel.app
# VITE_SITE_URL=https://bizzgu.vercel.app
