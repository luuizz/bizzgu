# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API / API Keys no painel do Supabase)

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (publishable). Projetos antigos chamam de "anon key" — funciona igual.
# Nunca coloque aqui a chave secreta / service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica

# Pasta onde o site fica publicado. Padrão: /bizzgu/ (GitHub Pages).
# Para Vercel, Netlify ou domínio próprio, use /
# VITE_BASE_PATH=/
